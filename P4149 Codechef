import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.io.IOException;

class Codechef {
    public static void main(String[] args) throws IOException {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        StringBuilder result = new StringBuilder();
        
        int t = Integer.parseInt(br.readLine().trim());  // Read number of test cases
        
        while (t-- > 0) {
            int n = Integer.parseInt(br.readLine().trim());  // Read size of the array
            String[] elements = br.readLine().trim().split(" ");
            
            long sum = 0;  // To store sum of absolute values
            int negCount = 0;  // Count of negative numbers
            int minAbsValue = Integer.MAX_VALUE;  // Track smallest absolute value
            
            for (int i = 0; i < n; i++) {
                int num = Integer.parseInt(elements[i]);
                sum += Math.abs(num);  // Sum of absolute values
                
                if (num < 0) {
                    negCount++;  // Increment count of negative numbers
                }
                
                minAbsValue = Math.min(minAbsValue, Math.abs(num));  // Update smallest absolute value
            }
            
            // If the count of negatives is odd, subtract twice the smallest absolute value
            if (negCount % 2 != 0) {
                sum -= 2 * minAbsValue;
            }
            
            result.append(sum).append("\n");  // Append the result for this test case
        }
        
        System.out.print(result);  // Print all results at once
    }
}
